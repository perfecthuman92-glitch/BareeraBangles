@inject IOptions<StoreSettings> StoreOptions
@{
    var store = StoreOptions.Value;
    var title = ViewData["Title"] as string;
    var pageTitle = string.IsNullOrEmpty(title) ? store.StoreName : $"{title} · {store.StoreName}";
    var meta = ViewData["MetaDescription"] as string ?? $"{store.StoreName} — premium bangles for adults and little ones.";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="@meta" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Sora:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="toast-host" id="toastHost" aria-live="polite"></div>
    <form id="antiForgeryForm" class="d-none">@Html.AntiForgeryToken()</form>

    @if (store.ShowPromoBanner && !string.IsNullOrWhiteSpace(store.PromoBannerText))
    {
        <div class="promo-strip">
            <a href="@store.PromoBannerLink">@store.PromoBannerText</a>
        </div>
    }

    <header class="site-header" id="siteHeader">
        <div class="container header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="@store.StoreName home">
                <span class="brand-mark" aria-hidden="true"></span>
                <span class="brand-text">@store.StoreName</span>
            </a>

            <button class="nav-toggle" type="button" id="navToggle" aria-label="Open menu" aria-expanded="false">
                <span></span><span></span>
            </button>

            <nav class="site-nav" id="siteNav">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Product" asp-action="Index">Shop</a>
                <a asp-controller="Home" asp-action="SizeGuide">Size Guide</a>
                <a asp-controller="Home" asp-action="Faq">FAQ</a>
                <a asp-controller="Wishlist" asp-action="Index">Wishlist</a>
                <a asp-controller="Compare" asp-action="Index">Compare</a>
                <a asp-controller="Order" asp-action="Track">Track Order</a>
                <a asp-controller="Home" asp-action="Contact">Contact</a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a>
                }
            </nav>

            <div class="header-actions">
                <div class="header-search">
                    <input type="search" id="globalSearch" placeholder="Search bangles…" autocomplete="off" />
                    <div class="search-suggest" id="searchSuggest" hidden></div>
                </div>
                <a class="icon-link" asp-controller="WhatsApp" asp-action="Chat" target="_blank" rel="noopener" title="Chat on WhatsApp">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.15 6.4 2.15 11.84c0 1.97.52 3.88 1.52 5.57L2 22l4.75-1.55a9.9 9.9 0 0 0 5.29 1.52h.01c5.46 0 9.89-4.4 9.89-9.84C21.94 6.4 17.5 2 12.04 2zm5.76 14.17c-.24.68-1.4 1.25-1.94 1.33-.5.07-1.13.1-1.83-.11-.42-.13-.96-.31-1.65-.61-2.9-1.26-4.78-4.18-4.93-4.38-.14-.2-1.18-1.57-1.18-3 0-1.42.74-2.12 1-2.41.26-.29.57-.36.76-.36h.55c.18 0 .42-.07.65.5.24.58.81 2 .88 2.15.07.14.12.32.02.51-.1.2-.14.32-.28.5-.14.17-.3.38-.42.51-.14.14-.28.29-.12.56.16.28.7 1.15 1.5 1.86 1.03.92 1.9 1.2 2.17 1.34.27.14.43.12.59-.07.16-.2.68-.79.86-1.06.18-.28.36-.23.61-.14.24.1 1.54.73 1.8.86.27.14.45.2.52.31.07.12.07.68-.17 1.36z"/></svg>
                </a>
                <a class="cart-link" asp-controller="Cart" asp-action="Index" aria-label="Shopping cart">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M7 18c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zM7.2 14h9.5c.75 0 1.41-.41 1.75-1.03l3.3-6.01A1 1 0 0 0 20.9 5H6.21l-.94-2H2v2h2l3.6 7.59-1.35 2.44A2 2 0 0 0 8 17h12v-2H8l1.2-1z"/></svg>
                    <span class="cart-count" id="cartCount">0</span>
                </a>
                <a class="cart-link" asp-controller="Wishlist" asp-action="Index" aria-label="Wishlist" title="Wishlist">
                    <span aria-hidden="true">♥</span>
                    <span class="cart-count" id="wishCount">0</span>
                </a>
                <a class="cart-link" asp-controller="Compare" asp-action="Index" aria-label="Compare" title="Compare">
                    <span aria-hidden="true">⇄</span>
                    <span class="cart-count" id="compareCount">0</span>
                </a>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </header>

    <main>
        @if (TempData["Success"] != null)
        {
            <div class="flash flash-success container">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="flash flash-error container">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <div>
                <div class="footer-brand">@store.StoreName</div>
                <p>@store.Tagline. Softly finished bangles for adults and little wrists, with sizes you can configure and trust.</p>
                <a class="btn btn-whatsapp" asp-controller="WhatsApp" asp-action="Chat" target="_blank" rel="noopener">Chat on WhatsApp</a>
            </div>
            <div>
                <h3>Shop</h3>
                <a asp-controller="Product" asp-action="Index">All Bangles</a>
                <a asp-controller="Product" asp-action="Index" asp-route-ageGroup="BabyKids">Baby &amp; Kids</a>
                <a asp-controller="Product" asp-action="Index" asp-route-ageGroup="Adult">Adult Sizes</a>
            </div>
            <div>
                <h3>Help</h3>
                <a asp-controller="Home" asp-action="About">About</a>
                <a asp-controller="Home" asp-action="Contact">Contact</a>
                <a asp-controller="Home" asp-action="SizeGuide">Size Guide</a>
                <a asp-controller="Home" asp-action="Faq">FAQ</a>
                <a asp-controller="Order" asp-action="Track">Track Order</a>
                <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                <a asp-controller="Home" asp-action="Terms">Terms &amp; Conditions</a>
            </div>
            <div>
                <h3>Payments</h3>
                <p>JazzCash, secure hosted card checkout, or cash on delivery. Card details are never stored on our servers.</p>
                <p class="muted">Currency: @store.Currency · Free shipping from @store.CurrencySymbol @store.FreeShippingThreshold.ToString("N0")</p>
                <form asp-controller="Home" asp-action="Newsletter" method="post" class="newsletter-form">
                    @Html.AntiForgeryToken()
                    <label>Newsletter
                        <input type="email" name="email" placeholder="you@email.com" required />
                    </label>
                    <button type="submit" class="btn btn-outline btn-sm">Subscribe</button>
                </form>
            </div>
        </div>
        <div class="container footer-bottom">
            <span>&copy; @DateTime.Now.Year @store.StoreName</span>
            <div class="social-links">
                <a href="@store.InstagramUrl" target="_blank" rel="noopener">Instagram</a>
                <a href="@store.FacebookUrl" target="_blank" rel="noopener">Facebook</a>
            </div>
        </div>
    </footer>

    <div class="modal fade" id="quickViewModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content quick-view-content" id="quickViewContent"></div>
        </div>
    </div>

    <a class="whatsapp-fab" asp-controller="WhatsApp" asp-action="Chat" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
        <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.15 6.4 2.15 11.84c0 1.97.52 3.88 1.52 5.57L2 22l4.75-1.55a9.9 9.9 0 0 0 5.29 1.52h.01c5.46 0 9.89-4.4 9.89-9.84C21.94 6.4 17.5 2 12.04 2zm5.76 14.17c-.24.68-1.4 1.25-1.94 1.33-.5.07-1.13.1-1.83-.11-.42-.13-.96-.31-1.65-.61-2.9-1.26-4.78-4.18-4.93-4.38-.14-.2-1.18-1.57-1.18-3 0-1.42.74-2.12 1-2.41.26-.29.57-.36.76-.36h.55c.18 0 .42-.07.65.5.24.58.81 2 .88 2.15.07.14.12.32.02.51-.1.2-.14.32-.28.5-.14.17-.3.38-.42.51-.14.14-.28.29-.12.56.16.28.7 1.15 1.5 1.86 1.03.92 1.9 1.2 2.17 1.34.27.14.43.12.59-.07.16-.2.68-.79.86-1.06.18-.28.36-.23.61-.14.24.1 1.54.73 1.8.86.27.14.45.2.52.31.07.12.07.68-.17 1.36z"/></svg>
    </a>

    <div class="cookie-banner" id="cookieBanner" hidden>
        <p>We use essential cookies for cart, wishlist, and compare. By continuing you agree to our <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>.</p>
        <button type="button" class="btn btn-primary btn-sm" id="cookieAccept">Got it</button>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
