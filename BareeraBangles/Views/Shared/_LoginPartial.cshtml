@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<div class="auth-links">
@if (SignInManager.IsSignedIn(User))
{
    <a class="auth-link" asp-controller="Order" asp-action="MyOrders" asp-area="">My Orders</a>
    <a class="auth-link" asp-area="Identity" asp-page="/Account/Manage/Index">Account</a>
    <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
        <button type="submit" class="auth-link btn-reset">Logout</button>
    </form>
}
else
{
    <a class="auth-link" asp-area="Identity" asp-page="/Account/Login">Login</a>
    <a class="auth-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
}
</div>
