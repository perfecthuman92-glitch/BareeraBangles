@{
    ViewData["Title"] = "About";
    var store = StoreOptions.Value;
}
<section class="page-hero"><div class="container"><h1>About @store.StoreName</h1><p>Crafted for modern wardrobes and little celebrations.</p></div></section>
<section class="section"><div class="container narrow prose">
    <p>@store.StoreName is a retail boutique focused on adult and baby/kids bangles with configurable sizing, clear product photography, and easy ordering through cart checkout or WhatsApp.</p>
    <p>Pay with JazzCash, secure hosted card checkout, or cash on delivery. Card details never touch our servers.</p>
</div></section>
