@{
    ViewData["Title"] = "Size Guide";
}
<section class="page-hero">
    <div class="container">
        <h1>Size Guide</h1>
        <p>Adult diameters and baby/kids labels — configurable in admin for each product.</p>
    </div>
</section>

<section class="section">
    <div class="container size-guide">
        <div class="guide-block">
            <h2>Adult sizes</h2>
            <p>Adult bangles are usually sold by inner diameter (inches). Measure across the inside of a well-fitting bangle.</p>
            <table class="guide-table">
                <thead><tr><th>Size</th><th>Inner diameter</th><th>Typical fit</th></tr></thead>
                <tbody>
                    <tr><td>2.2</td><td>2.2"</td><td>Petite / slim wrists</td></tr>
                    <tr><td>2.4</td><td>2.4"</td><td>Most common everyday fit</td></tr>
                    <tr><td>2.6</td><td>2.6"</td><td>Comfortable medium–large</td></tr>
                    <tr><td>2.8</td><td>2.8"</td><td>Larger wrists / layered stacks</td></tr>
                </tbody>
            </table>
        </div>

        <div class="guide-block">
            <h2>Baby &amp; kids sizes</h2>
            <p>Kids sizes on this store use age labels. These are <strong>not</strong> exact physical measurements — each product can have its own measurement notes set by the admin.</p>
            <table class="guide-table">
                <thead><tr><th>Label</th><th>Example measurement note</th></tr></thead>
                <tbody>
                    <tr><td>Newborn</td><td>approx. 1.4–1.6</td></tr>
                    <tr><td>0–6 Months</td><td>approx. 1.6–1.8</td></tr>
                    <tr><td>6–12 Months</td><td>approx. 1.8–2.0</td></tr>
                    <tr><td>1–2 Years</td><td>approx. 2.0–2.2</td></tr>
                    <tr><td>2–4 Years</td><td>approx. 2.2–2.4</td></tr>
                    <tr><td>4–6 Years</td><td>approx. 2.4–2.6</td></tr>
                    <tr><td>6–8 Years</td><td>approx. 2.6–2.8</td></tr>
                    <tr><td>8–10 Years</td><td>approx. 2.8–3.0</td></tr>
                </tbody>
            </table>
        </div>

        <div class="guide-block tip">
            <h2>Need help choosing?</h2>
            <p>Message us with a photo of a fitting bangle or the child’s age — we’ll recommend a size.</p>
            <a class="btn btn-whatsapp" asp-controller="WhatsApp" asp-action="Chat" asp-route-message="Hi! I need help choosing a bangle size." target="_blank" rel="noopener">Ask on WhatsApp</a>
        </div>
    </div>
</section>
