@model OrderViewModel
@{
    var store = StoreOptions.Value;
}
<section class="section">
    <div class="container narrow">
        <div class="confirm-card">
            <h1>Order @Model.OrderNumber</h1>
            <p>Status: @Model.Status · Payment: @Model.PaymentMethod / @Model.PaymentStatus</p>
            <p>Total: @store.CurrencySymbol @Model.GrandTotal.ToString("N0")</p>
            <ul class="confirm-items">
                @foreach (var item in Model.Items)
                {
                    <li><span>@item.ProductName (@item.SelectedSize) × @item.Quantity</span><span>@store.CurrencySymbol @item.TotalPrice.ToString("N0")</span></li>
                }
            </ul>
        </div>
    </div>
</section>
