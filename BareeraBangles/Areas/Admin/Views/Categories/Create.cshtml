@model AdminCategoryEditViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Add Category" : "Edit Category";
}
<h1>@ViewData["Title"]</h1>
<form method="post" class="admin-form">
    @Html.AntiForgeryToken()
    <div class="form-grid">
        <div class="full"><label asp-for="Name"></label><input asp-for="Name" /></div>
        <div class="full"><label asp-for="Description"></label><textarea asp-for="Description" rows="3"></textarea></div>
        <div><label asp-for="DisplayOrder"></label><input asp-for="DisplayOrder" /></div>
        <div><label asp-for="ImageUrl"></label><input asp-for="ImageUrl" /></div>
        <div><label><input asp-for="IsActive" /> Active</label></div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-ghost" asp-action="Index">Cancel</a>
</form>
