@model AdminProductEditViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Add Product" : "Edit Product";
}
<h1>@ViewData["Title"]</h1>
<form method="post" enctype="multipart/form-data" class="admin-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="validation-summary"></div>
    <div class="form-grid">
        <div class="full">
            <label asp-for="Name"></label>
            <input asp-for="Name" />
        </div>
        <div class="full">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" rows="4"></textarea>
        </div>
        <div>
            <label asp-for="Price"></label>
            <input asp-for="Price" />
        </div>
        <div>
            <label asp-for="DiscountPrice"></label>
            <input asp-for="DiscountPrice" />
        </div>
        <div>
            <label asp-for="CategoryId">Category</label>
            <select asp-for="CategoryId" asp-items="ViewBag.Categories"></select>
        </div>
        <div>
            <label asp-for="AgeGroup"></label>
            <select asp-for="AgeGroup" asp-items="Html.GetEnumSelectList<ProductAgeGroup>()"></select>
        </div>
        <div>
            <label><input asp-for="IsFeatured" /> Featured</label>
        </div>
        <div>
            <label><input asp-for="IsActive" /> Active</label>
        </div>
        <div>
            <label>Primary image upload</label>
            <input type="file" name="primaryImage" accept="image/*" />
            <input asp-for="PrimaryImageUrl" placeholder="or image URL / path" />
        </div>
        <div>
            <label>Secondary image upload</label>
            <input type="file" name="secondaryImage" accept="image/*" />
            <input asp-for="SecondaryImageUrl" placeholder="or image URL / path" />
        </div>
    </div>

    <h2>Sizes</h2>
    <p class="muted">Configure adult diameters or baby/kids labels and optional measurements. Customers must pick a size before checkout.</p>
    <div id="sizeRows">
        @for (var i = 0; i < Model.Sizes.Count; i++)
        {
            <div class="size-row">
                <input type="hidden" asp-for="Sizes[i].Id" />
                <input asp-for="Sizes[i].Size" placeholder="Size label" />
                <select asp-for="Sizes[i].SizeCategory" asp-items="Html.GetEnumSelectList<SizeCategory>()"></select>
                <input asp-for="Sizes[i].Measurement" placeholder="Measurement (optional)" />
                <input asp-for="Sizes[i].StockQuantity" />
                <label><input asp-for="Sizes[i].IsActive" /> Active</label>
                <label><input asp-for="Sizes[i].Remove" /> Remove</label>
            </div>
        }
    </div>
    <button type="button" class="btn btn-ghost" id="addSizeRow">Add Size</button>
    <button type="button" class="btn btn-ghost" id="addAdultSizes">Add adult template (2.2–2.8)</button>
    <button type="button" class="btn btn-ghost" id="addKidsSizes">Add baby/kids template</button>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-ghost" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
<script>
    window.bareeraSizeIndex = @Model.Sizes.Count;
</script>
}
