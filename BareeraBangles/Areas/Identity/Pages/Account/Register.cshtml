@page
@model BareeraBangles.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<section class="page-hero">
    <div class="container">
        <h1>Create account</h1>
        <p>Save your details for faster checkout next time.</p>
    </div>
</section>

<div class="account-wrap">
    <form id="registerForm" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div>
            <label asp-for="Input.Email"></label>
            <input asp-for="Input.Email" autocomplete="username" />
            <span asp-validation-for="Input.Email"></span>
        </div>
        <div>
            <label asp-for="Input.Password"></label>
            <input asp-for="Input.Password" autocomplete="new-password" />
            <span asp-validation-for="Input.Password"></span>
        </div>
        <div>
            <label asp-for="Input.ConfirmPassword"></label>
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100 mt-2">Register</button>
        <p class="mt-3"><a asp-page="./Login">Already have an account? Log in</a></p>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
